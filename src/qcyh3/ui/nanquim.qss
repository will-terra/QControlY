/* Nanquim — tema escuro do QControlY (PySide6 / Qt Style Sheets)
   Tokens: fundo #2d2b2b · rodapé #444141 · texto #f8f4f4 · secundário #bab6b6
           bordas #605d5d · ativo/links #62c5ee · vazio #9b9797
   Tipografia: Source Serif 4 (600 nos títulos). Alvos de 46px, raio 2px. */

QWidget {
    background: #2d2b2b;
    color: #f8f4f4;
    font-family: "Source Serif 4";
    font-size: 16px;
}

QMainWindow, QWidget#Panel {
    background: #2d2b2b;
}

/* Bateria — o número grande do topo */
QLabel#Battery {
    font-size: 40px;
    font-weight: 600;
    color: #f8f4f4;
}
QLabel#BatteryEmpty {
    font-size: 40px;
    font-weight: 600;
    color: #9b9797;
}
QLabel#DeviceName {
    font-size: 12px;
    letter-spacing: 2px;
    color: #bab6b6;
}
QLabel#Hint {
    font-size: 14px;
    color: #bab6b6;
}

/* ANC — botões checkable de largura cheia */
QPushButton#Anc {
    min-height: 46px;
    text-align: left;
    padding: 0 15px;
    font-size: 18px;
    font-weight: 600;
    color: #f8f4f4;
    background: transparent;
    border: 1px solid #605d5d;
    border-radius: 2px;
}
QPushButton#Anc:hover {
    background: #444141;
}
QPushButton#Anc:checked {
    background: #62c5ee;
    border-color: #62c5ee;
    color: #2d2b2b;
}
QPushButton#Anc:checked:hover {
    background: #8fd6f4;
}
QPushButton#Anc:disabled {
    color: #9b9797;
    border-color: #444141;
}
QPushButton#Anc:focus {
    outline: none;
    border: 2px solid #62c5ee;
}

/* Ações em texto — "Escanear", "Equalizador · Padrão" */
QPushButton#Link {
    min-height: 44px;
    padding: 0;
    border: none;
    background: transparent;
    font-size: 16px;
    color: #62c5ee;
    text-align: left;
}
QPushButton#Link:hover {
    color: #b7e6f8;
}

/* Ação primária do estado desconectado */
QPushButton#Primary {
    min-height: 46px;
    border: none;
    border-radius: 2px;
    background: #62c5ee;
    color: #2d2b2b;
    font-size: 17px;
    font-weight: 600;
}
QPushButton#Primary:hover {
    background: #8fd6f4;
}

/* Presets de EQ — linhas do bloco expansível */
QPushButton#EqRow {
    min-height: 44px;
    padding: 0;
    border: none;
    background: transparent;
    text-align: left;
    font-size: 16px;
    color: #bab6b6;
}
QPushButton#EqRow:hover {
    color: #f8f4f4;
}
QPushButton#EqRow:checked {
    color: #f8f4f4;
}

/* Lista de dispositivos do estado de escaneamento */
QListWidget {
    background: #2d2b2b;
    border: 1px solid #605d5d;
    border-radius: 2px;
    font-size: 16px;
    color: #f8f4f4;
}
QListWidget::item {
    min-height: 46px;
    padding: 0 15px;
}
QListWidget::item:selected {
    background: #62c5ee;
    color: #2d2b2b;
}

/* Rodapé do painel (Mostrar / Ocultar · Sair) */
QWidget#Footer {
    background: #444141;
}
QWidget#Footer QPushButton {
    border: none;
    background: transparent;
    font-size: 13px;
    color: #d7d3d3;
    padding: 10px 0;
}
QWidget#Footer QPushButton:hover {
    color: #f8f4f4;
}

/* Menu da bandeja */
QMenu {
    background: #2d2b2b;
    border: 1px solid #605d5d;
    color: #f8f4f4;
    padding: 5px;
}
QMenu::item {
    padding: 8px 15px;
    border-radius: 2px;
}
QMenu::item:selected {
    background: #62c5ee;
    color: #2d2b2b;
}

QStatusBar {
    background: #444141;
    color: #d7d3d3;
    font-size: 13px;
}
QToolTip {
    background: #444141;
    color: #f8f4f4;
    border: 1px solid #605d5d;
}
